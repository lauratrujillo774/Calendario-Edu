# Plantilla de backend/.env (cópiala como .env y completa). El .env real NO se sube a git.

# ---------- Base de datos ----------
# Local (XAMPP):  127.0.0.1 / 3306 / root / (sin clave) / MYSQL_SSL=false
# Aiven:          los datos de la pestaña "Connection information" del servicio MySQL, y MYSQL_SSL=true
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=calendario_edu
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_ZONA_HORARIA=-05:00
MYSQL_SSL=false
# Certificado de Aiven (CA certificate). Pega TODO su contenido en una sola línea cambiando cada salto de línea por \n. Opcional.
MYSQL_SSL_CA=

# ---------- Servidor ----------
PORT=3000
NODE_ENV=development
# Dirección pública (se usa en los enlaces de los correos), p. ej. https://educal.onrender.com
URL_APP=http://localhost:3000

# ---------- Google (iniciar sesión con Google) ----------
GOOGLE_CLIENT_ID=

# ---------- Correo SMTP (alertas por correo) ----------
CORREO_ACTIVO=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SEGURO=false
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=
